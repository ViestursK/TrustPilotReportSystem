# Database Configuration
# For PostgreSQL (production):
DATABASE_URL=postgresql://user:password@localhost:5432/trustpilot_db

# For SQLite (local development):
# DATABASE_URL=sqlite:///./local.db

# Trustpilot Scraping
BRANDS=ketogo.app
# ketogo.app, certifiedfasting.com, etc.


MAX_PAGES=10

# JWT Token for unlimited scraping (optional, for onboarding)
# Get this from Trustpilot cookies when logged in
JWT_ACCESS_TOKEN=

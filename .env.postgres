# PostgreSQL Configuration (use with docker-compose)
DATABASE_URL=postgresql://trustpilot_user:trustpilot_pass@localhost:5432/trustpilot_db

# For SQLite (local testing without Docker):
# DATABASE_URL=sqlite:///./local.db

# Brands to scrape (comma-separated)
BRANDS=ketogo.app

# Scraping settings
MAX_PAGES=10

